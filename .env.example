# Wird durch ./first_install.sh automatisch auf das Installationsverzeichnis gesetzt.
ABSOLUTE_PATH=${PWD}

PG_DB=authentik
PG_USER=authentik
PG_PASS=CHANGE_ME
AUTHENTIK_SECRET_KEY=CHANGE_ME
AUTHENTIK_TAG=2026.5

AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS=172.31.191.254/32,fd00:1:be:a:7001:0:3e:7fff/128

NETWORKS_PROXY_NAME=proxy
NETWORKS_AUTHENTIK_NAME=authentik
NETWORKS_AUTHENTIK_SOCKET_NAME=authentik-socket
NETWORKS_AUTHENTIK_SUBNET_IPV4=172.30.0.0/24
NETWORKS_AUTHENTIK_SUBNET_IPV6=fd00:dead:beef:f0::/64
NETWORKS_AUTHENTIK_SOCKET_SUBNET_IPV4=172.30.1.0/24
NETWORKS_AUTHENTIK_SOCKET_SUBNET_IPV6=fd00:dead:beef:f1::/64

SERVICES_SERVER_IPV4=172.30.0.2
SERVICES_SERVER_IPV6=fd00:dead:beef:f0::2
SERVICES_WORKER_IPV4=172.30.0.3
SERVICES_WORKER_IPV6=fd00:dead:beef:f0::3
SERVICES_DATABASE_IPV4=172.30.0.4
SERVICES_DATABASE_IPV6=fd00:dead:beef:f0::4
SERVICES_SOCKET_PROXY_IPV4=172.30.1.2
SERVICES_SOCKET_PROXY_IPV6=fd00:dead:beef:f1::2
SERVICES_WORKER_SOCKET_IPV4=172.30.1.3
SERVICES_WORKER_SOCKET_IPV6=fd00:dead:beef:f1::3
SERVICES_SERVER_PROXY_IPV4=172.31.191.128
SERVICES_SERVER_PROXY_IPV6=fd00:1:be:a:7001:0:3e:7128

TRAEFIK_CERTRESOLVER=cloudflare_resolver
TRAEFIK_CERT_DOMAIN=example.com
TRAEFIK_CERT_WILDCARD=*.example.com
SERVICES_AUTHENTIK_LABELS_AUTHENTIK_HOST=Host(`authentik.example.com`)
